{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "author.schema.json",
  "title": "Author",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name"],
  "properties": {
    "id": {
      "description": "Slug, equal to the file name without extension, e.g. 'fischer-manuela'.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": { "description": "Full name as printed on papers.", "type": "string" },
    "dblp": { "description": "DBLP person id (pid), e.g. '123/4567'.", "type": "string" },
    "orcid": { "type": "string", "pattern": "^\\d{4}-\\d{4}-\\d{4}-\\d{3}[\\dX]$" },
    "homepage": { "type": "string", "format": "uri" }
  }
}
